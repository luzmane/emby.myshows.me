<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>

    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- nuget setup -->
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Authors>Evgeniy Luzman</Authors>
    <Copyright>Copyright (c) 2025 Evgeniy Luzman</Copyright>
    <Description>An Emby plugin for scrobbing to MyShows.Me</Description>
    <PackageId>Emby.MyShowsMe</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>emby myshows</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../RELEASE-NOTES.md"))</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/luzmane/emby.myshows.me/</RepositoryUrl>
    <Title>MyShows.Me plugin for Emby</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="mediabrowser.server.core" Version="4.8.11"/>
    <PackageReference Include="System.Memory" Version="4.6.3"/>
    <PackageReference Include="System.Text.Json" Version="6.0.11"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath=""/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="thumb.png"/>

    <EmbeddedResource Include="Configuration\myshowsme.html" />
    <EmbeddedResource Include="Configuration\myshowsme.js" />
    <EmbeddedResource Include="Configuration\myshowsme.html"/>
    <EmbeddedResource Include="Configuration\myshowsme.js"/>

    <EmbeddedResource Include="i18n\Configuration\ru.json"/>
    <EmbeddedResource Include="i18n\Configuration\en-US.json"/>
  </ItemGroup>

</Project>
